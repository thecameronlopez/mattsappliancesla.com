---
import '../styles/index.css'
import ImageCarousel from "../components/ImageCarousel"
import RootLayout from "../layout/RootLayout.astro"
import SocialMediaBadges from "../components/SocialMediaBadges"
import ValidationBadge from "../components/ValidationBadge"
import BrandsBanner from '../components/BrandsBanner'
import Gallery from '../components/Gallery'

const sanitizeEnv = (value: any) =>
  String(value || "")
    .replace(/^['"]+|['"]+$/g, "")
    .trim();

const cloudName = sanitizeEnv(import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME);
const heroVideoId =
  sanitizeEnv(import.meta.env.PUBLIC_CLOUDINARY_HERO_VIDEO_PUBLIC_ID) ||
  "hero-loop";

const encodedHeroVideoId = heroVideoId
  .split("/")
  .map((segment) => encodeURIComponent(segment))
  .join("/");

const heroVideoBase = cloudName
  ? `https://res.cloudinary.com/${cloudName}/video/upload`
  : "";

const heroVideoMobileWebmSrc = heroVideoBase
  ? `${heroVideoBase}/q_auto:eco,vc_auto,w_720,f_webm/${encodedHeroVideoId}.webm`
  : "/videos/hero-loop.mp4";

const heroVideoMobileMp4Src = heroVideoBase
  ? `${heroVideoBase}/q_auto:eco,vc_auto,w_720,f_mp4/${encodedHeroVideoId}.mp4`
  : "/videos/hero-loop.mp4";

const heroVideoDesktopWebmSrc = heroVideoBase
  ? `${heroVideoBase}/q_auto:good,vc_auto,w_1280,f_webm/${encodedHeroVideoId}.webm`
  : "/videos/hero-loop.mp4";

const heroVideoDesktopMp4Src = heroVideoBase
  ? `${heroVideoBase}/q_auto:good,vc_auto,w_1280,f_mp4/${encodedHeroVideoId}.mp4`
  : "/videos/hero-loop.mp4";

const heroVideoPoster = heroVideoBase
  ? `${heroVideoBase}/so_0,q_auto:eco,w_1280,f_jpg/${encodedHeroVideoId}.jpg`
  : undefined;

---


<RootLayout
	title="Matt's New & Used Appliances | Sales, Financing, and Repair in Lake Charles, Jennings & Lafayette LA"
	description="Shop new, used, and scratch-and-dent appliances in Lake Charles, Jennings & Lafayette Louisiana. Matt's Appliances offers affordable pricing, financing options, and experienced appliance service."
>
	<section id="hero">
		<h1>New & Used Appliances in Lake Charles, Jennings & Lafayette, LA</h1>
		<p class="hero-eyebrow">Scratch & Dent Refrigerators, Washers, Dryers, Ovens</p>
		<p>
			We don&apos;t want anything to get in the way of the necessities. That&apos;s why we offer top tier leasing and financing options to get you the appliance you need, today!
		</p>
		<a class="learn-more" href="/payment-plans">
			Explore Payment Plans
		</a>
		<video
			autoplay
			muted
			loop
			playsinline
			preload="metadata"
			class="hero-video"
			poster={heroVideoPoster}
		>
			<source
				src={heroVideoMobileWebmSrc}
				type="video/webm"
				media="(max-width: 767px)"
			/>
			<source
				src={heroVideoMobileMp4Src}
				type="video/mp4"
				media="(max-width: 767px)"
			/>
			<source src={heroVideoDesktopWebmSrc} type="video/webm" />
			<source src={heroVideoDesktopMp4Src} type="video/mp4" />
		</video>
	</section>
	<section id="who-are-we">
		<div class="text-block">
			<h2>Who are we?</h2>
			<p>
				We&apos;re a Christian owned business whose focus is on helping our community! For the last 12 years we&apos;ve been able to offer new & used appliances at affordable prices. We strive to ensure customer satisfaction with our products and services!
			</p>
			<p>
				Matt&apos;s Appliances provides new, used, and scratch-and-dent appliances in Lake Charles, Jennings, and Lafayette, Louisiana. We carry refrigerators, washers, dryers, stoves, and ranges from brands like Whirlpool, Samsung, and GE. Our stores serve customers across Southwest Louisiana who are looking for affordable appliances with financing and leasing options.
			</p>
		</div>
		<ImageCarousel client:visible />
	</section>
	<section id="social-media">
		<h2>Check us out on social media</h2>
		<SocialMediaBadges />
	</section>
	<section id="validation">
		<h2>Why Southwest Louisiana shops with us</h2>
		<ValidationBadge title="Trusted & Reliable" icon={"/icon-badges/trusted_and_reliable.svg"} desc="Any machine purchased at Matt's is backed by a 30-day warranty! Ask us about our Extended Warrant Program as well for 100% satisfaction gauranteed." />
		<ValidationBadge title="Leasing Available" icon={"/icon-badges/money.svg"} desc="We offer leasing options to make your appliance purchase easy and affordable. Apply for Acima with only $50 down! or get financed through Tower Loan to take home your appliance today." />
		<ValidationBadge title="Trade Your Appliances" icon={"/icon-badges/appliances.svg"} desc="Whether used or broken, we buy/sell/trade refrigerators, freezers, stove tops, washers & dryers." />
		<ValidationBadge title="Experienced Team" icon={"/icon-badges/tools.svg"} desc="With technicians that are EPA certified with over 88 years of combined experience." />
	</section>
	<section id="brands">
		<!-- <h2>We carry top brands that you know and trust</h2> -->
		<BrandsBanner />
	</section>
	<section id="image-banner">
		<h2>Make Your Home, <span class="scripted">Home.</span></h2>
	</section>
	<section id="payment-plans">
		<h2>Find A Plan That Fits</h2>
		<div class="plan tower-loan lifted">
			<h3>Tower Loan</h3>
			<img src="/images/payment-plans/tower-loan-logo.png" alt="Tower Loan Logo" width="225" height="225" loading="lazy" decoding="async">
			<p>
				Interest free for 12 months, instant approval, even covers taxes! When Matt's Appliances partnered with Tower Loan, we made it easy for you to have the appliance you need to make sure your home operates as smooth as possible. Tower Loan makes your remodeling project a breeze. With a simple and fast application process, it will only take a few minutes to get you back up and running, getting your life back on track in no time!
			</p>
			<a class="learn-more" href="/payment-plans/tower-loan">Learn more about Tower Loan</a>
		</div>
		<div class="plan acima lifted">
			<h3>Acima</h3>
			<img class="acima-flyer-generic" src="/images/payment-plans/acima-generic.jpg" alt="Acima Leasing flyer" width="800" height="800" loading="lazy" decoding="async">
			<p>
				Lease it until you own it or purchase early at a discounted rate! Either way, it's yours to keep. The sooner you do so, the more you'll save. Of course, if you no longer want the appliance, you can return it in good condition at anytime without penalty. Our application is fast and easy to complete, and won't harm your credit. You could get approved for $300 or $5,000 of shopping power! Just by meeting the basic requirements.
			</p>
			<a class="learn-more" href="/payment-plans/acima">Learn more about Acima</a>
		</div>
	</section>
	<section id="gallery">
		<Gallery client:visible />
	</section>
	<section id="lifetime">
		<div>
			<p>All appliances are eligible for our</p>
			<h2>Life Time Extended Warranty</h2>
			<p>Starting as low as $7.99/mo</p>
		</div>
		<a class="learn-more" href="/about">Learn more about Matt&apos;s Appliances</a>
	</section>
</RootLayout>
