---
import "../../styles/locations.css"
import RootLayout from "../../layout/RootLayout.astro";

const pageSchema = {
    "@context": "https://schema.org",
    "@type": "ApplianceStore",
    "@id": "https://mattsappliancesla.com/locations/jennings/#primary-store",
    name: "Matt's Appliances - Jennings",
    url: "https://mattsappliancesla.com/locations/jennings/",
    image: "https://mattsappliancesla.com/images/locations/jennings-store-front.jpg",
    telephone: "+1-337-388-4350",
    email: "sales@mattsappliancesla.net",
    priceRange: "$$",
    address: {
        "@type": "PostalAddress",
        streetAddress: "314 E Shankland Ave",
        addressLocality: "Jennings",
        addressRegion: "LA",
        postalCode: "70546",
        addressCountry: "US",
    },
    openingHoursSpecification: [
        {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday"],
            opens: "08:30",
            closes: "18:00",
        },
        {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: "Friday",
            opens: "10:00",
            closes: "18:00",
        },
        {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: "Saturday",
            opens: "10:00",
            closes: "17:00",
        },
    ],
};
---

<RootLayout
    title="Jennings Appliance Store | Matt's Appliances"
    description="Visit Matt's Appliances in Jennings, LA for affordable new and used appliances with local service, delivery options, and financing support."
    pageSchema={pageSchema}
>
    <section class="location-header jn-header">
        <h1>Jennings, LA</h1>
        <p>Our first step in expansion.</p>
    </section>
    <section class="location-faqs">
        <p>
            Our second location brings Matt's Appliances closer to our customers in Jefferson Davis Parish. Stop by to browse a curated selection of quality appliances and enjoy the same great prices and services as our Lake Charles store.
        </p>
        <p>
            We're proud to serve Jennings and the surrounding area. Helping more families find affordable appliances with delivery and installation options available!
        </p>
    </section>
    <section class="location-directions">
            <iframe title="Map to Matt's Appliances Jennings location" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4089.0400243757317!2d-92.65822252393912!3d30.23188800966451!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x863b5b84b91f0cd9%3A0xca1202e28625cdc3!2sMatt&#39;s%20New%20%26%20Used%20Appliances%20-%20Jennings!5e1!3m2!1sen!2sus!4v1769460138676!5m2!1sen!2sus" width="100%" height="300" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" />
            <a class="direction-button" href="https://www.google.com/maps/dir/?api=1&destination=314+E+Shankland+Ave,+Jennings,+LA+70546" target="_blank" rel="noopener noreferrer"
 >Take Me There</a>
    </section>
  <section class="location-details" aria-labelledby="jennings-details-title">
    <div class="location-details__intro">
      <p class="location-details__eyebrow">Visit Us</p>
      <h2 id="jennings-details-title">Jennings Store Details</h2>
    </div>
    <div class="location-details__grid">
      <div class="location-details__card">
        <h3>Address</h3>
        <p>606 N Lake Arthur Avenue</p>
        <p>Jennings, LA 70546</p>
      </div>
      <div class="location-details__card">
        <h3>Phone</h3>
        <p><a href="tel:3378243947">(337) 824-3947</a></p>
      </div>
      <div class="location-details__card">
        <h3>Business Hours</h3>
        <p>Monday - Friday: 9:00 AM - 6:00 PM</p>
        <p>Saturday: 9:00 AM - 3:00 PM</p>
        <p>Sunday: Closed</p>
      </div>
    </div>
  </section>

</RootLayout>
