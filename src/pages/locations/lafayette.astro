---
import "../../styles/locations.css"
import RootLayout from "../../layout/RootLayout.astro";

const pageSchema = {
    "@context": "https://schema.org",
    "@type": "ApplianceStore",
    "@id": "https://mattsappliancesla.com/locations/lafayette/#primary-store",
    name: "Matt's Appliances - Lafayette",
    url: "https://mattsappliancesla.com/locations/lafayette/",
    image: "https://mattsappliancesla.com/images/locations/lafayette-promo.png",
    telephone: "+1-337-602-6045",
    email: "sales@mattsappliancesla.net",
    priceRange: "$$",
    address: {
        "@type": "PostalAddress",
        streetAddress: "1308 Moss St",
        addressLocality: "Lafayette",
        addressRegion: "LA",
        postalCode: "70501",
        addressCountry: "US",
    },
};
---


<RootLayout
    title="Lafayette Appliance Store | Matt's Appliances"
    description="Matt's Appliances is opening in Lafayette, LA in early Summer 2026. Visit 1308 Moss St. for affordable new, used, and scratch-and-dent appliances."
    pageSchema={pageSchema}
>
    <section class="location-header lf-header">
        <h1>Lafayette, LA</h1>
        <p>Growth in action!</p>
    </section>
    <section class="location-faqs">
        <p>
            Our third location is set to open early Summer 2026! We can't wait to bring the same Deals, the same Savings, the same Ministry to Acadiana
        </p>
        <p>
            We're proud to serve Lafayette and the surrounding area. Helping more families find affordable appliances with delivery and installation options available!
        </p>
    </section>
    <section class="location-directions">
            <iframe title="Map to Matt's Appliances Lafayette location" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3446.7976365379905!2d-92.00876292443864!3d30.242846774824287!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x86249bac4d0d8465%3A0x2aae282cc4e1d2d6!2sMatt&#39;s%20New%20%26%20Used%20Appliances%20-%20Lafayette!5e0!3m2!1sen!2sus!4v1773756967861!5m2!1sen!2sus" width="400" height="300" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"/>
            <a class="direction-button" href="https://www.google.com/maps/dir/?api=1&destination=1308+Moss+St,+Lafayette,+LA+70501" target="_blank" rel="noopener noreferrer"
 >Take Me There</a>
    </section>
  <section class="location-details" aria-labelledby="lafayette-details-title">
    <div class="location-details__intro">
      <p class="location-details__eyebrow">Visit Us</p>
      <h2 id="lafayette-details-title">Lafayette Store Details</h2>
    </div>
    <div class="location-details__grid">
      <div class="location-details__card">
        <h3>Address</h3>
        <p>111 Meadow Farm Road</p>
        <p>Lafayette, LA 70508</p>
      </div>
      <div class="location-details__card">
        <h3>Phone</h3>
        <p><a href="tel:3376026045">(337) 602-6045</a></p>
      </div>
      <div class="location-details__card">
        <h3>Business Hours</h3>
        <p>Opening early Summer 2026</p>
        <p>Hours coming soon</p>
      </div>
    </div>
  </section>

</RootLayout>
