---
import "../../styles/locations.css"
import RootLayout from "../../layout/RootLayout.astro";
import { getHiringLocation } from "../../data/hiring";

const hiringLocation = getHiringLocation("lake-charles");

const pageSchema = {
    "@context": "https://schema.org",
    "@type": "ApplianceStore",
    "@id": "https://mattsappliancesla.com/locations/lake-charles/#primary-store",
    name: "Matt's Appliances - Lake Charles",
    url: "https://mattsappliancesla.com/locations/lake-charles/",
    image: "https://mattsappliancesla.com/images/locations/store-front-2.JPG",
    telephone: "+1-337-244-7589",
    email: "sales@mattsappliancesla.net",
    priceRange: "$$",
    address: {
        "@type": "PostalAddress",
        streetAddress: "2600 Common St",
        addressLocality: "Lake Charles",
        addressRegion: "LA",
        postalCode: "70601",
        addressCountry: "US",
    },
    openingHoursSpecification: [
        {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday"],
            opens: "08:30",
            closes: "18:00",
        },
        {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: "Friday",
            opens: "10:00",
            closes: "18:00",
        },
        {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: "Saturday",
            opens: "10:00",
            closes: "17:00",
        },
    ],
};
---

<RootLayout
    title="Lake Charles Appliance Store | Matt's Appliances"
    description="Visit Matt's Appliances in Lake Charles, LA for new, used, and scratch-and-dent refrigerators, washers, dryers, and more."
    pageSchema={pageSchema}
>
    <section class="location-header lc-header">
        <h1>Lake Charles, LA</h1>
        <p>Our flagship store.</p>
    </section>
    <section class="location-faqs">
        <p>
            Here you'll find our largest selection of new and gently used appliances, including refrigerators, washers, dryers, ranges, and more! All at competative prices. Our friendly staff is ready to help you find the right appliance for your home and get it delivered fast!
        </p>
        <p>
            Whether you're shopping for a full kitchen set or just replacing one appliance, this is the perfect place to start. Financing and Leasing options are available right here in-store.
        </p>
    </section>
    {hiringLocation?.enabled && hiringLocation.url && (
    <section class="location-careers" aria-labelledby="lake-charles-careers-title">
        <div class="location-careers__intro">
            <p class="location-details__eyebrow">Careers</p>
            <h2 id="lake-charles-careers-title">Join Our Lake Charles Team</h2>
            <p>Explore current openings and apply online.</p>
        </div>
        <iframe
            class="location-careers__frame"
            src={hiringLocation.url}
            title="Matt's Appliances Lake Charles careers page"
            loading="lazy"
            width="100%"
            height="1100"
            style="border:none;"
        ></iframe>
        <a
            class="location-careers__link"
            href={hiringLocation.url}
            target="_blank"
            rel="noopener noreferrer"
        >
            Open careers page in a new tab
        </a>
    </section>
    )}
    <section class="location-directions">
            <iframe title="Map to Matt's Appliances Lake Charles location" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d8180.16904672607!2d-93.21691492393985!3d30.206764310860883!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x863b8681115273e9%3A0xb60e4a9e29e2d4ed!2sMatt&#39;s%20New%20%26%20Used%20Appliances!5e1!3m2!1sen!2sus!4v1769459272606!5m2!1sen!2sus" width="100%" height="300" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" />
            <a class="direction-button" href="https://www.google.com/maps/dir/?api=1&destination=2600+Common+St+Lake+Charles+LA+70601" target="_blank" rel="noopener noreferrer"
 >Take Me There</a>
    </section>
  <section class="location-details" aria-labelledby="lake-charles-details-title">
    <div class="location-details__intro">
      <p class="location-details__eyebrow">Visit Us</p>
      <h2 id="lake-charles-details-title">Lake Charles Store Details</h2>
    </div>
    <div class="location-details__grid">
      <div class="location-details__card">
        <h3>Address</h3>
        <p>2600 Common St.</p>
        <p>Lake Charles, LA 70601</p>
      </div>
      <div class="location-details__card">
        <h3>Phone</h3>
        <p><a href="tel:3372447589">(337) 244-7589</a></p>
      </div>
      <div class="location-details__card">
        <h3>Business Hours</h3>
        <p>Monday - Friday: 8:30 AM - 6:00 PM</p>
        <p>Saturday: 9:00 AM - 5:00 PM</p>
        <p>Sunday: Closed</p>
      </div>
    </div>
  </section>

</RootLayout>
