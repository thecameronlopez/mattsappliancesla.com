---
import "../../styles/payment-plans.css"
import RootLayout from "../../layout/RootLayout.astro";
---

<RootLayout
    title="Tower Loan Financing | Matt's Appliances"
    description="Learn about Tower Loan appliance financing at Matt's Appliances, including quick applications and promotional 0% interest terms."
>
    <section class="payment-plan-hero">
        <div class="payment-plan-hero__copy">
            <p class="payment-plan-hero__eyebrow">Financing</p>
            <h1>Tower Loan <span>Financing</span></h1>
            <p>Keep your home running smooth, no matter what.</p>
        </div>
        <div class="payment-plan-hero__highlight">
            <p class="big bolded">Quick approvals for qualifying purchases</p>
        </div>
    </section>
    <section class="plan-faqs">
        <div class="plan-faqs__content">
            <p class="plan-faqs__eyebrow">What To Expect</p>
            <h2>We can get you the appliance you need, fast!</h2>
            <p>Partnered with Tower Loan, we can help you get set up in minutes.</p>
            <ul>
                <li>
                    5 - 10 minute application
                </li>
                <li class="bolded">
                    Instant approval
                </li>
                <li>
                    24 month repayment term
                </li>
                <li class="bolded">
                    12 month - 0% interest
                </li>
                <li>Credit check required</li>
                <li>
                    Taxes included in financing
                </li>
                <li>
                    Photo ID scanned during application
                </li>
            </ul>
            <p class="plan-faqs__cta">Come in and see what we have to offer.</p>
        </div>
        <aside class="plan-faqs__aside plan-faqs__aside--summary">
            <div class="plan-summary-card">
                <p class="plan-summary-card__eyebrow">At A Glance</p>
                <h3>Tower Loan</h3>
                <p>Financing for customers who want a traditional approval flow and promotional terms on qualifying purchases.</p>
                <ul>
                    <li>Fast application in store</li>
                    <li>Promotional 0% term available</li>
                    <li>Best for planned replacement purchases</li>
                </ul>
            </div>
        </aside>
    </section>
    <section class="we-got-what-you-need">
        <h2>We've Got What You Need</h2>
    </section>
</RootLayout>
