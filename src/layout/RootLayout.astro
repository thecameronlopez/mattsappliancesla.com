---
let {
  title = "Matt's Appliances | Lake Charles, Jennings & Lafayette",
  description =
    "Matt's Appliances sells affordable new, used, and scratch-and-dent refrigerators, washers, dryers, and more in Lake Charles, Jennings, and Lafayette Louisiana.",
  noindex = false,
  ogType = "website",
  ogImage = "/images/matts-logo.png",
} = Astro.props;
import '../styles/global.css'
import Header from '../components/Header'

const site = Astro.site ?? new URL("https://mattsappliancesla.com");
const canonicalUrl = new URL(Astro.url.pathname, site).toString();
const ogImageUrl = new URL(ogImage, site).toString();

const organizationSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://mattsappliancesla.com/#organization",
      name: "Matt's Appliances",
      url: "https://mattsappliancesla.com",
      email: "mattsusedappliances@gmail.com",
      sameAs: [
        "https://www.facebook.com/mattsusedappliances",
        "https://www.instagram.com/mattsnewandusedappliances/",
        "https://www.yelp.com/biz/matts-appliances-lake-charles-3?osq=Matt%E2%80%99s+Appliances",
      ],
    },
    {
      "@type": "ApplianceStore",
      "@id": "https://mattsappliancesla.com/locations/lake-charles/#store",
      name: "Matt's Appliances - Lake Charles",
      url: "https://mattsappliancesla.com/locations/lake-charles/",
      image: ogImageUrl,
      telephone: "+1-337-244-7589",
      email: "mattsusedappliances@gmail.com",
      address: {
        "@type": "PostalAddress",
        streetAddress: "2600 Common St",
        addressLocality: "Lake Charles",
        addressRegion: "LA",
        postalCode: "70601",
        addressCountry: "US",
      },
      openingHoursSpecification: [
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday"],
          opens: "08:30",
          closes: "18:00",
        },
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: "Friday",
          opens: "10:00",
          closes: "18:00",
        },
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: "Saturday",
          opens: "10:00",
          closes: "17:00",
        },
      ],
      parentOrganization: { "@id": "https://mattsappliancesla.com/#organization" },
    },
    {
      "@type": "ApplianceStore",
      "@id": "https://mattsappliancesla.com/locations/jennings/#store",
      name: "Matt's Appliances - Jennings",
      url: "https://mattsappliancesla.com/locations/jennings/",
      image: ogImageUrl,
      telephone: "+1-337-388-4350",
      email: "mattsusedappliances@gmail.com",
      address: {
        "@type": "PostalAddress",
        streetAddress: "314 E Shankland Ave",
        addressLocality: "Jennings",
        addressRegion: "LA",
        postalCode: "70546",
        addressCountry: "US",
      },
      openingHoursSpecification: [
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday"],
          opens: "08:30",
          closes: "18:00",
        },
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: "Friday",
          opens: "10:00",
          closes: "18:00",
        },
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: "Saturday",
          opens: "10:00",
          closes: "17:00",
        },
      ],
      parentOrganization: { "@id": "https://mattsappliancesla.com/#organization" },
    },
  ],
};
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="description" content={description}>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <link rel="icon" href="/images/matts-logo.png" type="image/png">
    <link rel="shortcut icon" href="/images/matts-logo.png" type="image/png">
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <title>{title}</title>
    <script type="text/partytown" async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-65REEDCECB"></script>
    <script type="text/partytown" is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    
      gtag('config', 'G-65REEDCECB');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
</head>
<!-- Google tag (gtag.js) -->
<body>
    <Header client:load />
    <main>
        <slot></slot>
    </main>
    <footer>
        <img class="footer-logo" src="/images/matts-logo.png" alt="Matt's Appliances, LLC Logo">
        <p class="footer-title">Matt's Appliances, LLC</p>
        <p>mattsusedappliances@gmail.com</p>
        <div class="locations-footer">
            <div class="location lake-charles">
                <address class="address">
                    <h4>Lake Charles</h4>
                    <p>2600 Common St</p>
                    <p>Lake Charles, LA, 70601</p>
                    <p>(337) 244-7589</p>
                </address>
                <div class="hours">
                    <h4>Hours</h4>
                    <p>Mon-Thur: <span>8:30AM-6:00PM</span></p>
                    <p>Fri: <span>10AM-6PM</span></p>
                    <p>Sat: <span>10AM-5PM</span></p>
                </div>
            </div>
            <div class="location jennings">
                <address class="address">
                    <h4>Jennings</h4>
                    <p>314 E. Shankland Ave.</p>
                    <p>Jennings, LA, 70546</p>
                    <p>(337) 388-4350</p>
                </address>
                <div class="hours">
                    <h4>Hours</h4>
                    <p>Mon-Thur: <span>8:30AM-6:00PM</span></p>
                    <p>Fri: <span>10AM-6PM</span></p>
                    <p>Sat: <span>10AM-5PM</span></p>
                </div>
            </div>
            <p class="scripted" style="font-size: 1.5rem;">We are closed on Sundays</p>
        </div>
    </footer>
</body>
</html>
