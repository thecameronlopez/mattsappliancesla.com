---
let {
  title = "Matt's Appliances | Lake Charles, Jennings & Lafayette",
  description =
    "Matt's Appliances sells affordable new, used, and scratch-and-dent refrigerators, washers, dryers, and more in Lake Charles, Jennings, and Lafayette Louisiana.",
  noindex = false,
  ogType = "website",
  ogImage = "/images/matts-logo.png",
  pageSchema = null,
} = Astro.props;
import '../styles/global.css'
import Header from '../components/Header'

const site = Astro.site ?? new URL("https://mattsappliancesla.com");
const canonicalUrl = new URL(Astro.url.pathname, site).toString();
const ogImageUrl = new URL(ogImage, site).toString();

const organizationSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://mattsappliancesla.com/#organization",
      name: "Matt's Appliances",
      url: "https://mattsappliancesla.com",
      email: "sales@mattsappliancesla.net",
      sameAs: [
        "https://www.facebook.com/mattsusedappliances",
        "https://www.instagram.com/mattsnewandusedappliances/",
        "https://www.yelp.com/biz/matts-appliances-lake-charles-3?osq=Matt%E2%80%99s+Appliances",
      ],
    },
    {
      "@type": "ApplianceStore",
      "@id": "https://mattsappliancesla.com/locations/lake-charles/#store",
      name: "Matt's Appliances - Lake Charles",
      url: "https://mattsappliancesla.com/locations/lake-charles/",
      image: ogImageUrl,
      telephone: "+1-337-244-7589",
      email: "sales@mattsappliancesla.net",
      address: {
        "@type": "PostalAddress",
        streetAddress: "2600 Common St",
        addressLocality: "Lake Charles",
        addressRegion: "LA",
        postalCode: "70601",
        addressCountry: "US",
      },
      openingHoursSpecification: [
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday"],
          opens: "08:30",
          closes: "18:00",
        },
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: "Friday",
          opens: "10:00",
          closes: "18:00",
        },
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: "Saturday",
          opens: "10:00",
          closes: "17:00",
        },
      ],
      parentOrganization: { "@id": "https://mattsappliancesla.com/#organization" },
    },
    {
      "@type": "ApplianceStore",
      "@id": "https://mattsappliancesla.com/locations/jennings/#store",
      name: "Matt's Appliances - Jennings",
      url: "https://mattsappliancesla.com/locations/jennings/",
      image: ogImageUrl,
      telephone: "+1-337-388-4350",
      email: "sales@mattsappliancesla.net",
      address: {
        "@type": "PostalAddress",
        streetAddress: "314 E Shankland Ave",
        addressLocality: "Jennings",
        addressRegion: "LA",
        postalCode: "70546",
        addressCountry: "US",
      },
      openingHoursSpecification: [
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday"],
          opens: "08:30",
          closes: "18:00",
        },
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: "Friday",
          opens: "10:00",
          closes: "18:00",
        },
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: "Saturday",
          opens: "10:00",
          closes: "17:00",
        },
      ],
      parentOrganization: { "@id": "https://mattsappliancesla.com/#organization" },
    },
    {
      "@type": "ApplianceStore",
      "@id": "https://mattsappliancesla.com/locations/lafayette/#store",
      name: "Matt's Appliances - Lafayette",
      url: "https://mattsappliancesla.com/locations/lafayette/",
      image: ogImageUrl,
      telephone: "+1-337-274-7877",
      email: "sales@mattsappliancesla.net",
      address: {
        "@type": "PostalAddress",
        streetAddress: "1308 Moss St",
        addressLocality: "Lafayette",
        addressRegion: "LA",
        postalCode: "70501",
        addressCountry: "US",
      },
      parentOrganization: { "@id": "https://mattsappliancesla.com/#organization" },
    },
  ],
};
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="description" content={description}>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <link rel="icon" href="/images/matts-logo.png" type="image/png">
    <link rel="shortcut icon" href="/images/matts-logo.png" type="image/png">
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <title>{title}</title>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-65REEDCECB"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    
      gtag('config', 'G-65REEDCECB');
    </script>
    <script is:inline>
      const syncFooterLocationCards = () => {
        const isDesktop = window.matchMedia("(min-width: 768px)").matches;
        document.querySelectorAll("details[data-footer-location]").forEach((card) => {
          if (isDesktop) {
            card.setAttribute("open", "");
          } else {
            card.removeAttribute("open");
          }
        });
      };

      window.addEventListener("DOMContentLoaded", syncFooterLocationCards, { once: true });
      window.addEventListener("resize", syncFooterLocationCards);
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {pageSchema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
    )}
</head>
<!-- Google tag (gtag.js) -->
<body>
    <Header client:load />
    <main>
        <slot></slot>
    </main>
    <footer class="site-footer">
        <div class="footer-main">
            <div class="footer-info">
                <div class="footer-top">
                    <img class="footer-logo" src="/images/matts-logo.png" alt="Matt's Appliances, LLC Logo" width="934" height="766" loading="lazy" decoding="async">
                    <div class="footer-brand">
                        <p class="footer-title">Matt's Appliances, LLC</p>
                        <a class="footer-email" href="mailto:sales@mattsappliancesla.net">sales@mattsappliancesla.net</a>
                        <p class="footer-tagline">Serving Southwest Louisiana since 2014</p>
                    </div>
                </div>
                <nav class="footer-quicklinks" aria-label="Footer quick links">
                    <a href="/">Home</a>
                    <a href="/locations">Locations</a>
                    <a href="/payment-plans">Payment Plans</a>
                    <a href="/about">About</a>
                </nav>
            </div>
            <div class="locations-footer">
                <h2 class="sr-only">Store locations</h2>
                <details class="location-card-footer" data-footer-location>
                    <summary>
                        <div class="location-summary">
                            <h3>Lake Charles</h3>
                            <address class="address">
                                <p>2600 Common St</p>
                                <p>Lake Charles, LA, 70601</p>
                            </address>
                            <a class="footer-phone" href="tel:+13372447589">(337) 244-7589</a>
                        </div>
                    </summary>
                    <div class="location-details">
                        <div class="hours">
                            <p>Mon-Thur: <span>8:30AM-6:00PM</span></p>
                            <p>Fri: <span>10AM-6PM</span></p>
                            <p>Sat: <span>10AM-5PM</span></p>
                        </div>
                    </div>
                </details>
                <details class="location-card-footer" data-footer-location>
                    <summary>
                        <div class="location-summary">
                            <h3>Jennings</h3>
                            <address class="address">
                                <p>314 E. Shankland Ave.</p>
                                <p>Jennings, LA, 70546</p>
                            </address>
                            <a class="footer-phone" href="tel:+13373884350">(337) 388-4350</a>
                        </div>
                    </summary>
                    <div class="location-details">
                        <div class="hours">
                            <p>Mon-Thur: <span>8:30AM-6:00PM</span></p>
                            <p>Fri: <span>10AM-6PM</span></p>
                            <p>Sat: <span>10AM-5PM</span></p>
                        </div>
                    </div>
                </details>
                <details class="location-card-footer" data-footer-location>
                    <summary>
                        <div class="location-summary">
                            <h3>Lafayette</h3>
                            <address class="address">
                                <p>1308 Moss St.</p>
                                <p>Lafayette, LA, 70501</p>
                            </address>
                            <a class="footer-phone" href="tel:+13372747877">(337) 274-7877</a>
                        </div>
                    </summary>
                    <div class="location-details">
                        <div class="hours">
                            <p>Mon-Thur: <span>TBD</span></p>
                            <p>Fri: <span>TBD</span></p>
                            <p>Sat: <span>TBD</span></p>
                        </div>
                    </div>
                </details>
            </div>
        </div>
        <p class="footer-note scripted">We are closed on Sundays</p>
    </footer>
    <script is:inline>
      (() => {
        const details = document.querySelector(".location-details");
        if (!details) return;

        const faqSection = document.querySelector(".location-faqs");
        if (faqSection) {
          let content = faqSection.querySelector(".location-faqs__content");
          if (!content) {
            content = document.createElement("div");
            content.className = "location-faqs__content";

            const nodes = Array.from(faqSection.childNodes).filter(
              (node) => node !== details
            );

            for (const node of nodes) {
              content.appendChild(node);
            }

            faqSection.appendChild(content);
          }

          faqSection.appendChild(details);
        }
      })();
    </script>
    <script is:inline>
      (() => {
        const normalize = (value) => {
          if (!value) return "/";
          const url = new URL(value, window.location.origin);
          const pathname = url.pathname.replace(/\/+$/, "");
          return pathname || "/";
        };

        const currentPath = normalize(window.location.pathname);
        const headerLinks = document.querySelectorAll("header nav a[href]");

        headerLinks.forEach((link) => {
          const linkPath = normalize(link.getAttribute("href"));
          const isCurrent =
            linkPath === "/"
              ? currentPath === "/"
              : currentPath === linkPath || currentPath.startsWith(`${linkPath}/`);

          if (isCurrent) {
            link.setAttribute("aria-current", "page");
          } else {
            link.removeAttribute("aria-current");
          }
        });
      })();
    </script>
  </body>
</html>
